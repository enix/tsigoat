      "required": [
        "enabled",
        "interval",
        "scrapeTimeout"
      ],
      "type": "object"
    },
    "strategy": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "default": 30,
      "minimum": 0,
      "type": "integer"
    },
    "tolerations": {
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "topologySpreadConstraints": {
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    }
