    "imagePullSecrets": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "listenHost": {
      "default": "[::]",
      "minLength": 1,
      "type": "string"
    },
    "livenessProbe": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "json",
          "enum": [
            "text",
            "json"
          ],
          "type": "string"
        },
        "level": {
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "type": "string"
    },
    "namespaceOverride": {
      "default": "",
      "type": "string"
    },
    "nodeSelector": {
      "additionalProperties": {
        "type": "string"
      },
      "required": [],
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": {
        "type": "string"
      },
      "required": [],
      "type": "object"
    },
    "podDisruptionBudget": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "maxUnavailable": {
          "default": 1,
          "minimum": 0,
          "pattern": "^[0-9]+%$",
          "required": [],
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "priorityClassName": {
      "default": "",
      "type": "string"
    },
    "prometheusRules": {
      "additionalProperties": false,
      "properties": {
        "alertLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "disabledAlerts": {
          "items": {
            "enum": [
              "TsigoatBackendErrors",
              "TsigoatUncertainUpdates",
              "TsigoatUpdatesFailing",
              "TsigoatSignatureFailures",
              "TsigoatLegacyAlgorithm"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "extraLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "selector": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "selector"
      ],
      "type": "object"
    },
    "readinessProbe": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "replicaCount": {
      "default": 2,
      "minimum": 1,
      "type": "integer"
    },
    "resources": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "secret": {
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "default": "",
          "type": "string"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        }
      },
      "required": [
        "existingSecret"
      ],
      "type": "object"
    },
    "securityContext": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "allocateLoadBalancerNodePorts": {
          "default": true,
          "type": "boolean"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "clusterIP": {
          "default": "",
          "type": "string"
        },
        "externalIPs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "externalTrafficPolicy": {
          "default": "",
          "enum": [
            "",
            "Cluster",
            "Local"
          ],
          "type": "string"
        },
        "extraLabels": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "healthCheckNodePort": {
          "default": 0,
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "internalTrafficPolicy": {
          "default": "",
          "enum": [
            "",
            "Cluster",
            "Local"
          ],
          "type": "string"
        },
        "ipFamilies": {
          "items": {
            "enum": [
              "IPv4",
              "IPv6"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "ipFamilyPolicy": {
          "default": "",
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ],
          "type": "string"
        },
        "loadBalancerClass": {
          "default": "",
          "type": "string"
        },
        "loadBalancerIP": {
          "default": "",
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "nodePort": {
          "default": 0,
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "port": {
          "default": 53,
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "sessionAffinity": {
          "default": "None",
          "enum": [
            "None",
            "ClientIP"
          ],
          "type": "string"
        },
        "sessionAffinityTimeoutSeconds": {
          "default": 10800,
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "trafficDistribution": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "ClusterIP",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ],
          "type": "string"
        }
      },
      "required": [
        "clusterIP",
        "trafficDistribution",
        "loadBalancerClass",
        "loadBalancerIP"
      ],
      "type": "object"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "create": {
          "default": true,
          "type": "boolean"
