  "required": [
    "nameOverride",
    "fullnameOverride",
    "namespaceOverride",
    "image",
    "podDisruptionBudget",
    "secret",
    "log",
    "service",
    "admin",
    "serviceMonitor",
    "prometheusRules",
    "serviceAccount",
    "priorityClassName",
    "extraDeploy"
  ],
  "type": "object"
}
