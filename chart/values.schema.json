          "required": [],
          "type": "object"
        },
        "interval": {
          "default": "",
          "type": "string"
        },
        "metricRelabelings": {
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
        },
        "relabelings": {
          "items": {
            "required": [],
            "type": "object"
          },
          "type": "array"
