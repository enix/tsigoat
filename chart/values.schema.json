{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "admin": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "default": 9153,
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "affinity": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "config": {
      "additionalProperties": true,
      "required": [],
      "type": "object"
    },
    "extraDeploy": {
      "items": {
        "required": []
      },
      "type": "array"
    },
    "extraEnv": {
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraLabels": {
      "additionalProperties": {
        "type": "string"
      },
      "required": [],
      "type": "object"
    },
    "extraVolumeMounts": {
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "extraVolumes": {
      "items": {
        "required": [],
        "type": "object"
      },
      "type": "array"
    },
    "fullnameOverride": {
      "default": "",
      "type": "string"
    },
    "global": {
      "additionalProperties": true,
      "properties": {
        "imageRegistry": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "imageRegistry"
      ],
      "type": "object"
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "default": "",
          "type": "string"
        },
        "digests": {
          "additionalProperties": {
            "type": "string"
          },
          "required": [],
          "type": "object"
        },
        "pinDigest": {
          "default": true,
          "type": "boolean"
        },
        "pullPolicy": {
          "default": "IfNotPresent",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "type": "string"
        },
        "registry": {
          "default": "ghcr.io",
          "type": "string"
        },
        "repository": {
          "default": "enix/tsigoat",
          "minLength": 1,
          "type": "string"
        },
        "tag": {
          "default": "",
          "type": "string"
        },
        "tagSuffix": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "tag",
        "tagSuffix",
        "digest",
        "pinDigest"
      ],
      "type": "object"
