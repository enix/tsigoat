# Default image variant. `FROM scratch` holds nothing but the static Go
# binary; TLS roots come from golang.org/x/crypto/x509roots/fallback, which
# is linked into the binary. Use the busybox variant (Dockerfile.busybox)
# when a shell is needed for debugging.
#
# GoReleaser dockers_v2 lays out the build context with one directory per
# target platform and passes the matching one as $TARGETPLATFORM.

FROM scratch

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/tsigoat /tsigoat

USER 65534:65534

EXPOSE 5353/udp 5353/tcp

ENTRYPOINT ["/tsigoat"]
