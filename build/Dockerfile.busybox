# Alternative image variant with a busybox shell, for environments that
# need one to debug a running container. The default variant is scratch
# (Dockerfile.scratch).
#
# GoReleaser dockers_v2 lays out the build context with one directory per
# target platform and passes the matching one as $TARGETPLATFORM.

FROM busybox:1.38.0@sha256:fd7dc98638c8e305f4dc34e979f1c0fdfdcaeb0fbf8fcff77ae834b6da3d7e6e

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/tsigoat /tsigoat

# Numeric user, so that the same line works with the scratch variant, which
# has no /etc/passwd.
USER 65534:65534

EXPOSE 5353/udp 5353/tcp

ENTRYPOINT ["/tsigoat"]
